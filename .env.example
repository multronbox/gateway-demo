# 正式部署先需要填；Codespaces 示範唔使填任何嘢（DEMO_MODE 由 devcontainer 預設開）。
# 真 key 只放部署環境，唔好 commit 入 repo。

# 示範模式：1 = 開（模擬回應、免 token）；正式部署請設 0 或刪除
DEMO_MODE=0

# Gateway 訪客 token（正式模式先用，可多個，逗號分隔）
GATEWAY_TOKENS=

# Gemini（只供伺服器內部使用，唔會回傳俾呼叫者）
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=

# Claude 插槽開關（目前客戶未訂閱，保持 false）
CLAUDE_ENABLED=false
